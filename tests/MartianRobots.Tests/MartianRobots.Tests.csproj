<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\brief-sample.txt" Link="brief-sample.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MartianRobots\MartianRobots.csproj" />
    <ProjectReference Include="..\..\src\MartianRobots.Cli\MartianRobots.Cli.csproj" />
    <ProjectReference Include="..\..\src\MartianRobots.Api\MartianRobots.Api.csproj" />
  </ItemGroup>

  <!-- The API tests load ASP.NET's shared framework, which keeps the console app's logging package out of the test folder.
       The console tests run the app from a copy of its own build output instead. -->
  <Target Name="CopyConsoleAppBesideTests" AfterTargets="Build">
    <ItemGroup>
      <ConsoleAppFile Include="..\..\src\MartianRobots.Cli\bin\$(Configuration)\$(TargetFramework)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ConsoleAppFile)" DestinationFolder="$(OutDir)console-app\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
